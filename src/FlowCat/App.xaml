<Application x:Class="FlowCat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:v="clr-namespace:FlowCat.Views"
             StartupUri="Views/MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <v:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <v:GroupNameToVisibilityConverter x:Key="GroupNameToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
