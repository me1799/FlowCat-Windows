<ui:FluentWindow
    x:Class="FlowCat.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:vm="clr-namespace:FlowCat.ViewModels"
    xmlns:v="clr-namespace:FlowCat.Views"
    Title="小微Cat"
    Width="400" Height="560"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <vm:TrayViewModel x:Key="TrayVM" />
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.DataContext>
        <StaticResource ResourceKey="TrayVM" />
    </ui:FluentWindow.DataContext>

    <Grid>
        <!-- System tray icon -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/Assets/tray-icon.ico"
            ToolTipText="{Binding Tooltip}"
            DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示主窗口" Command="{Binding ShowWindowCommand}" />
                    <MenuItem x:Name="OverlayMenuItem" Header="悬浮窗" IsCheckable="True" IsChecked="True"
                              Click="OnOverlayToggle" />
                    <MenuItem x:Name="AutoStartMenuItem" Header="开机自启" IsCheckable="True"
                              Click="OnAutoStartToggle" />
                    <Separator />
                    <MenuItem Header="退出" Command="{Binding ExitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="小微Cat" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinBtn" Content="📌" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="OnPinClick" FontSize="11" ToolTip="固定窗口"
                                Opacity="0.4" Padding="4,0" />
                        <Button Content="✕" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="OnCloseClick" Padding="4,0" FontSize="11" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ConnLabel" FontSize="10" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Speed cards -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="10" Padding="12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="↓ 下载" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding DownloadSpeed}" FontSize="18" FontWeight="Bold"
                                   Foreground="#2196F3" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="10" Padding="12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="↑ 上传" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding UploadSpeed}" FontSize="18" FontWeight="Bold"
                                   Foreground="#4CAF50" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tab buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton x:Name="TabNetwork" Content="网络" IsChecked="True"
                             GroupName="Tabs" Click="OnTabChanged"
                             Style="{StaticResource {x:Type RadioButton}}" Margin="0,0,10,0"
                             FontSize="12" />
                <RadioButton x:Name="TabDisk" Content="磁盘"
                             GroupName="Tabs" Click="OnTabChanged"
                             Style="{StaticResource {x:Type RadioButton}}" Margin="0,0,10,0"
                             FontSize="12" />
                <RadioButton x:Name="TabStats" Content="统计"
                             GroupName="Tabs" Click="OnTabChanged"
                             Style="{StaticResource {x:Type RadioButton}}"
                             FontSize="12" />
            </StackPanel>

            <!-- Tab content -->
            <v:ProcessListView x:Name="ProcessPanel" Grid.Row="3" />
            <v:DiskIoView x:Name="DiskPanel" Grid.Row="3" Visibility="Collapsed" />
            <v:StatsView x:Name="StatsPanel" Grid.Row="3" Visibility="Collapsed" />
        </Grid>
    </Grid>
</ui:FluentWindow>
